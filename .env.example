# AI API Prices — deployment environment.
#
#   cp .env.example .env
#
# Docker Compose reads .env automatically. It is git-ignored; never commit the
# real file. Nothing here is required to run the app locally.

# Where the published site is reachable on the host itself. Loopback on
# purpose: expose it through whatever ingress you put in front, not directly.
APP_BIND_HOST=127.0.0.1
APP_PORT=3100

# Destination of the header's OXWeb link. Inlined at build time, so changing it
# requires `docker compose up -d --build`.
NEXT_PUBLIC_OXWEB_URL=https://oxweb.xyz
