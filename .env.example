# AI API Prices — local container settings.
#
#   cp .env.example .env
#
# Docker Compose reads .env automatically. The local .env file is git-ignored.

# Host binding for the app container.
APP_BIND_HOST=127.0.0.1
APP_PORT=3100

# Destination of the header's OXWeb link. This value is inlined at build time.
NEXT_PUBLIC_OXWEB_URL=https://oxweb.xyz
